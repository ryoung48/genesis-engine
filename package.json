{
	"name": "chaos-machine",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc -b",
		"build": "tsc -b && vite build",
		"lint": "knip --fix --allow-remove-files && biome check --write --unsafe",
		"preview": "vite preview",
		"test": "vitest run --project unit --coverage",
		"test:unit": "vitest run --project unit",
		"test:coverage": "pnpm test",
		"gen:lang": "vitest run --project smoke src\\model\\actors\\language\\language.smoke.test.ts",
		"gen:history": "vitest run --project smoke src\\model\\history\\history.smoke.test.ts",
		"gen:snapshot": "vitest run --project smoke src\\model\\history\\snapshot.smoke.test.ts",
		"gen:world": "vitest run --project smoke src\\model\\pipelines\\generate-default-world.smoke.test.ts",
		"knip": "knip"
	},
	"dependencies": {
		"@datastructures-js/priority-queue": "^6.3.5",
		"@tailwindcss/vite": "^4.1.18",
		"chart.js": "^4.5.1",
		"delaunator": "^5.0.1",
		"react": "^19.2.0",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.9.5",
		"three": "^0.183.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.183.1",
		"@vitejs/plugin-react": "^5.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"knip": "^6.7.0",
		"tailwindcss": "^4.2.4",
		"typescript": "~5.9.3",
		"vite": "npm:rolldown-vite@7.2.5",
		"vitest": "^4.0.17"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.2.5"
		}
	}
}
