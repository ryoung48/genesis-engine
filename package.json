{
	"name": "chaos-machine",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc -b",
		"build": "tsc -b && vite build",
		"lint": "biome check --write --unsafe",
		"test:history": "vitest run --project history-smoke",
		"test:history:related": "vitest related --run --project history-smoke",
		"preview": "vite preview",
		"gen:lang": "vitest run --project smoke src/model/actors/language/language.smoke.test.ts",
		"gen:history": "vitest run --project smoke src/test/history-run/history-run.smoke.test.ts",
		"report:history": "vitest run --project smoke src/test/history-run/history-report.smoke.test.ts",
		"calibrate:siege": "vitest run --project smoke src/test/history-run/siege-calibration.smoke.test.ts",
		"diff:history": "node --experimental-strip-types scripts/history-diff.mjs",
		"gen:world": "vitest run --project smoke src/test/generate-default-world.smoke.test.ts",
		"gen:world:earth-temp-compare": "vitest run --project smoke src/test/earth/earth-real-temperature-compare.smoke.test.ts",
		"build:earth-real-population-eu4": "python scripts/regenerate-earth-population.py",
		"build:earth-real-urban-population-eu4": "python scripts/regenerate-earth-population.py",
		"knip": "knip --fix",
		"check:underscore-unused": "node scripts/quality/check-underscore-unused.mjs",
		"fix:import-aliases": "node scripts/quality/fix-import-aliases.mjs",
		"check:optional-attributes": "node scripts/quality/check-optional-attributes.mjs"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"chart.js": "^4.5.1",
		"d3-contour": "^4.0.2",
		"d3-delaunay": "^6.0.4",
		"delaunator": "^5.0.1",
		"gl-matrix": "^3.4.4",
		"react": "^19.2.0",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.9.5",
		"three": "^0.183.2",
		"troika-three-text": "^0.52.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/d3-contour": "^3.0.6",
		"@types/d3-delaunay": "^6.0.4",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.183.1",
		"@vitejs/plugin-react": "^5.1.1",
		"@vitest/coverage-v8": "4.1.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"jpeg-js": "^0.4.4",
		"knip": "^6.7.0",
		"playwright": "^1.62.1",
		"pngjs": "^7.0.0",
		"tailwindcss": "^4.2.4",
		"ts-morph": "^28.0.0",
		"typescript": "~5.9.3",
		"vite": "npm:rolldown-vite@7.2.5",
		"vitest": "^4.0.17"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.2.5"
		}
	}
}
